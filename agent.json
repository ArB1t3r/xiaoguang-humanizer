{
  "schema_version": "1",
  "id": "xiaoguang-humanizer",
  "display_name": "小光Humanizer",
  "version": "1.2.0",
  "type": "agent-skill",
  "repository": "https://github.com/ArB1t3r/xiaoguang-humanizer",
  "license": "MIT",
  "entrypoint": "SKILL.md",
  "integration_guide": "docs/agent-integration.md",
  "references": {
    "always": [
      "references/anti-patterns.md"
    ],
    "zh": [
      "references/chinese.md"
    ],
    "en": [
      "references/english.md"
    ],
    "maintenance": [
      "references/sources.md",
      "references/evaluation-cases.md"
    ]
  },
  "capabilities": {
    "modes": [
      "rewrite",
      "audit",
      "draft"
    ],
    "languages": [
      "zh",
      "en",
      "mixed"
    ],
    "bilingual_output": true,
    "voice_samples": true
  },
  "defaults": {
    "mode": "rewrite",
    "language": "preserve",
    "strength": "standard",
    "output": "final-text"
  },
  "runtime": {
    "host_agent_required": true,
    "bundled_model": false,
    "hosted_api": false,
    "network_required_for_editing": false
  },
  "validation": {
    "command": "python3 scripts/validate.py",
    "requires": "Python 3.10+ standard library",
    "scope": "Package structure and fixture integrity, not model quality"
  },
  "chat_entrypoints": {
    "quick_zh": "prompts/quick-start.zh.txt",
    "quick_en": "prompts/quick-start.en.txt",
    "full": "prompts/xiaoguang-humanizer-full.txt",
    "scope": "current conversation unless saved in host-supported persistent instructions",
    "status": "legacy prompt exports; not skill installation and not the default onboarding route"
  },
  "installation": {
    "entrypoint": "INSTALL.md",
    "runtime_path": "plugins/xiaoguang-humanizer/skills/xiaoguang-humanizer",
    "skill_archive": "https://github.com/ArB1t3r/xiaoguang-humanizer/releases/latest/download/xiaoguang-humanizer-skill.zip",
    "plugin_path": "plugins/xiaoguang-humanizer",
    "marketplace": ".agents/plugins/marketplace.json",
    "verification": "docs/agent-integration.md#verify-installation",
    "persistent_installation_required": true
  },
  "distribution": {
    "skill_files": [
      "SKILL.md",
      "LICENSE",
      "agents/openai.yaml",
      "references/anti-patterns.md",
      "references/chinese.md",
      "references/english.md",
      "references/evaluation-cases.md",
      "references/sources.md",
      "references/source-manifest.json"
    ]
  }
}
